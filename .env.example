# Public site URL (used for sitemap, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Supabase — optional. Without these the site still works:
# solo mode runs fully in the browser, party mode offers "practice vs bots",
# and results are not stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by /api/runs to write and aggregate anonymous results.
SUPABASE_SERVICE_ROLE_KEY=
