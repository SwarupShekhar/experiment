# Optional. Defaults: Vercel's production URL, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Supabase (already set in .env.production / .env.development for the block9 project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server-only. Not required: everything works through public RPC functions.
SUPABASE_SERVICE_ROLE_KEY=
